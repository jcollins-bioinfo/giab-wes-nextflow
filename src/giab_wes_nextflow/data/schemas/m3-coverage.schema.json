{
  "$id": "https://raw.githubusercontent.com/jcollins-bioinfo/giab-wes-nextflow/main/schemas/m3-coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "coverage"
    },
    "canonical": {
      "const": false
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "benchmark_domain": {
          "const": false
        },
        "domain_kind": {
          "const": "whole_invented_reference_target_independent"
        },
        "maximum_depth": {
          "minimum": 0,
          "type": "integer"
        },
        "mean_depth": {
          "minimum": 0,
          "type": "number"
        },
        "minimum_depth": {
          "minimum": 0,
          "type": "integer"
        },
        "primary_evaluation_bases": {
          "type": "null"
        },
        "reference_bases": {
          "minimum": 1,
          "type": "integer"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rounding_note": {
          "minLength": 1,
          "type": "string"
        },
        "summed_depth_bases": {
          "minimum": 0,
          "type": "integer"
        },
        "target_aware_acceptance": {
          "const": "blocked"
        }
      },
      "required": [
        "domain_kind",
        "reference_bases",
        "summed_depth_bases",
        "mean_depth",
        "minimum_depth",
        "maximum_depth",
        "primary_evaluation_bases",
        "target_aware_acceptance",
        "benchmark_domain",
        "rounding_note",
        "reference_sha256"
      ],
      "type": "object"
    },
    "input_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "type": "string"
          },
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "filename": {
            "minLength": 1,
            "type": "string"
          },
          "record_count": {
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "filename",
          "role",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missingness": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "minLength": 1,
          "type": "string"
        },
        "package": {
          "const": "giab-wes-nextflow"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "module"
      ],
      "type": "object"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "runtime_architecture": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "units": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "validation_status": {
      "const": "validated_synthetic"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "producer",
    "synthetic",
    "canonical",
    "validation_status",
    "runtime_architecture",
    "input_artifacts",
    "units",
    "missingness",
    "data",
    "payload_sha256"
  ],
  "type": "object"
}
