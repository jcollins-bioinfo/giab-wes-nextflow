// Separate native-container path. Never includes the Colab runtime config.
params {
    cloud_allow_spend = false
    cloud_backend = 'unconfigured'
    cloud_manifest = null
    cloud_manifest_sha256 = null
    cloud_repository_sha = null
    cloud_support_image = null
    cloud_images = [:]
    cloud_batch_queue = 'CONFIGURED_ONLY_NOT_AUTHORIZED'
    cloud_batch_job_role = null
    cloud_batch_benchmark_job_role = null
    cloud_batch_job_definitions = [:]
    cloud_batch_definitions_receipt = null
    cloud_batch_definitions_receipt_sha256 = null
    cloud_max_cpus = 8
    cloud_max_memory = '44 GB'
    cloud_max_time = '48h'
}
process {
    stageInMode = 'copy'
    cache = 'deep'
    cpus = 2
    memory = '8 GB'
    time = params.cloud_max_time
    maxForks = 2
    resourceLimits = [cpus: params.cloud_max_cpus, memory: params.cloud_max_memory, time: params.cloud_max_time]
    errorStrategy = { task.exitStatus == 75 && task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries = 2
    withLabel: cloud_support { container = params.cloud_support_image; cpus = 2; memory = '8 GB' }
    withLabel: cloud_bwa { container = params.cloud_images.bwa ?: 'quay.io/biocontainers/bwa@sha256:c3a708bea7947a44288e675fd9791c7aaf0c97dba0710addba336ed193821f8a'; cpus = 4; memory = '24 GB' }
    withLabel: cloud_samtools { container = params.cloud_images.samtools ?: 'quay.io/biocontainers/samtools@sha256:a130447589651ed09252aa95a5e4f4132942cdb54d835d81a04a9a930d656561'; cpus = 4; memory = '8 GB' }
    withLabel: cloud_gatk { container = params.cloud_images.gatk ?: 'registry-1.docker.io/broadinstitute/gatk@sha256:7da5cf586e1c463f0c72908f9ac7dec8c29e37912c82d6e7b3c250f27fcb3891'; cpus = 4; memory = '24 GB' }
    withLabel: cloud_deepvariant { container = params.cloud_images.deepvariant ?: 'registry-1.docker.io/google/deepvariant@sha256:962e5a83b1d76aae6990625d47102785f791603f2138aa1fa9aa4fb6a2eecbe6'; cpus = 8; memory = '44 GB' }
    withLabel: cloud_bcftools { container = params.cloud_images.bcftools ?: 'quay.io/biocontainers/bcftools@sha256:a3e0d3007ffe325c409b398f660840a3e7574d076219c6e82fc994ced87d47c3'; cpus = 2; memory = '8 GB' }
    withLabel: cloud_rtg { container = params.cloud_images.rtg ?: 'registry-1.docker.io/realtimegenomics/rtg-tools@sha256:b53115f1646258c5bd7af1e884fd06f1eab70ebb4ebc1161fff1e5529e200790'; cpus = 4; memory = '24 GB' }
}
executor.queueSize = 4
