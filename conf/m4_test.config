includeConfig 'm3_test.config'
params {
    workflow_mode = 'm4_synthetic'
    m3_fixture_id = 'm4-snv-positive'
    input = "${projectDir}/tests/data/m4-generated/samplesheet.csv"
    reference = "${projectDir}/tests/data/m4-generated/reference.fa"
    known_sites = "${projectDir}/tests/data/m4-generated/known-sites.vcf"
    m3_fixture_manifest = "${projectDir}/tests/data/m4-generated/fixture-expectations.json"
}
// Sequential tiny qualification bounds memory without caller-mode cache tokens.
executor.queueSize = 1
process {
    withLabel: m4_gatk { cpus = 2; memory = '4 GB'; time = '30m' }
    withLabel: m4_deepvariant { cpus = 2; memory = '8 GB'; time = '30m' }
}
