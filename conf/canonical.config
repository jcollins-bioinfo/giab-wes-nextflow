// Package-owned runtime launches isolated tools; task scheduling remains local.
// All ceilings are validated again against the actual host by canonical_runtime.
params {
    canonical_max_cpus = 8
    canonical_max_memory = '44 GB'
    canonical_max_time = '48h'
    canonical_allow_cloud_spend = false
}
executor.queueSize = 1
process {
    executor = 'local'
    withLabel: /canonical_(shared|caller|benchmark)/ {
        cpus = params.canonical_max_cpus
        memory = params.canonical_max_memory
        time = params.canonical_max_time
        maxForks = 1
        container = null
        // 75 is an explicit temporary failure. OOM, bad biological inputs and
        // scientific acceptance failures terminate without changing parameters.
        errorStrategy = { task.exitStatus == 75 && task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
}
