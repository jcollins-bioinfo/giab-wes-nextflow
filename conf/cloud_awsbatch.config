includeConfig 'cloud.config'
params.cloud_backend = 'awsbatch'
aws.region = 'us-west-2'
aws.batch.cliPath = '/opt/giab-awscli/bin/aws'
process.executor = 'awsbatch'
process.queue = params.cloud_batch_queue
// Explicit immutable revisions bind each scientific image and task role.
// No unsupported containerOptions role override and no auto-registration.
// scripts/aws/batch_check.py verifies actual AWS definitions before scheduling.
process {
    withName: CLOUD_AUTHENTICATE { container = { params.cloud_batch_job_definitions['support-benchmark'] } }
    withName: CLOUD_BWA_ALIGN { container = { params.cloud_batch_job_definitions['bwa'] } }
    withName: CLOUD_SORT { container = { params.cloud_batch_job_definitions['samtools'] } }
    withName: CLOUD_MARK_DUPLICATES { container = { params.cloud_batch_job_definitions['gatk'] } }
    withName: CLOUD_BQSR { container = { params.cloud_batch_job_definitions['gatk'] } }
    withName: CLOUD_BAM_OBSERVATIONS { container = { params.cloud_batch_job_definitions['samtools'] } }
    withName: CLOUD_BAM_GATE { container = { params.cloud_batch_job_definitions['support'] } }
    withName: CLOUD_GATK_CALL { container = { params.cloud_batch_job_definitions['gatk'] } }
    withName: CLOUD_DEEPVARIANT_CALL { container = { params.cloud_batch_job_definitions['deepvariant'] } }
    withName: CLOUD_PREPARE_TRUTH { container = { params.cloud_batch_job_definitions['bcftools-benchmark'] } }
    withName: CLOUD_NORMALIZE { container = { params.cloud_batch_job_definitions['bcftools'] } }
    withName: CLOUD_INCLUDE { container = { params.cloud_batch_job_definitions['support'] } }
    withName: CLOUD_COMPRESS { container = { params.cloud_batch_job_definitions['bcftools'] } }
    withName: CLOUD_RTG_REFERENCE { container = { params.cloud_batch_job_definitions['rtg'] } }
    withName: CLOUD_VCFEVAL { container = { params.cloud_batch_job_definitions['rtg-benchmark'] } }
    withName: CLOUD_COLLECT { container = { params.cloud_batch_job_definitions['support-benchmark'] } }
}
