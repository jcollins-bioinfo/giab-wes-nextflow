// CONFIGURED_ONLY. Deliberately unschedulable placeholder queue. The canonical
// launcher must reject cloud execution before scheduling unless separately
// authorized; setting this profile alone never supplies credentials or spend.
includeConfig 'canonical.config'
process.executor = 'awsbatch'
process.queue = 'CONFIGURED_ONLY_NOT_AUTHORIZED'
aws.region = 'us-east-1'
params.canonical_execution_environment = 'awsbatch_configured_only'
