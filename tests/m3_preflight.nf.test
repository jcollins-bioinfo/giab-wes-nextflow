nextflow_process {
    name 'M3 exact invented source boundary'
    script '../modules/local/m3_preflight/main.nf'
    process 'M3_PREFLIGHT'
    tag 'm3'
    test('installed package validates exact fixture before any genomics tool') {
        when {
            process {
                """
                def source = "${projectDir}/tests/data/m3-generated"
                input[0] = file(source + "/samplesheet.csv")
                input[1] = file(source + "/reference.fa")
                input[2] = file(source + "/known-sites.vcf")
                input[3] = file(source + "/fixture-expectations.json")
                input[4] = [file(source + "/reads_1.fastq.gz"), file(source + "/reads_2.fastq.gz"), file(source + "/reads_lane2_1.fastq.gz"), file(source + "/reads_lane2_2.fastq.gz")]
                input[5] = [run_id:'nf-test-source', repository_sha:'0000000000000000000000000000000000000000']
                """
            }
        }
        then {
            assert process.success
            def source = path(process.out.contract[0]).json
            assert source.artifact_type == 'preflight'
            assert source.synthetic && !source.canonical
            assert source.validation_status == 'validated_synthetic'
            assert source.data.repository_sha == '0000000000000000000000000000000000000000'
            assert source.payload_sha256 ==~ /[0-9a-f]{64}/
            def resources = path(process.out.resources[0]).json
            assert resources.task_id == null
            assert resources.logical_artifact_id == 'source_preflight'
            assert resources.requested_cpus == 1
            assert resources.requested_memory_bytes > 0
            assert resources.requested_time_seconds > 0
            assert resources.container == null
        }
    }
}
