// Isolated managed qualification; the production version guard is unchanged.
manifest.nextflowVersion = '==26.04.0'
process {
    cpus = 1
    memory = '2 GB'
    time = '5m'
    maxForks = 1
    maxRetries = 0
    errorStrategy = 'terminate'
}
executor.queueSize = 1
trace {
    enabled = true
    file = 'cache-trace.tsv'
    fields = 'task_id,name,status,hash,container'
}
