// Only the nonhuman qualification package may install this as its root config.
manifest.nextflowVersion = '==26.04.0'
includeConfig '../../conf/cloud.config'
params.cloud_backend = 'healthomics'
params.cloud_max_cpus = 4
params.cloud_max_memory = '24 GB'
params.cloud_max_time = '45m'
params.cloud_images = [bwa: params.bwa_image, samtools: params.samtools_image,
    gatk: params.gatk_image, deepvariant: params.deepvariant_image,
    bcftools: params.bcftools_image, rtg: params.rtg_image]
process {
    maxForks = 1
    maxRetries = 0
    errorStrategy = 'terminate'
    withLabel: cloud_bwa { cpus = 2; memory = '8 GB' }
    withLabel: cloud_samtools { cpus = 2; memory = '8 GB' }
    withLabel: cloud_gatk { cpus = 4; memory = '24 GB' }
    withLabel: cloud_deepvariant { cpus = 2; memory = '8 GB' }
    withLabel: cloud_rtg { cpus = 2; memory = '8 GB' }
}
env.RTG_MEM = '2G'
executor.queueSize = 2
