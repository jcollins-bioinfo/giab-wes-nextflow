        },
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:GetObjectVersion"
          ],
          "Resource": [
            "arn:${partition}:s3:::${data_bucket}/truth/*"
          ]
        },
        {
