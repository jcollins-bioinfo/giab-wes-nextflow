          ],
          "Resource": "arn:${partition}:ecr:${region}:${account}:repository/${name}/explorer"
        },
        {
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "logs:DescribeLogStreams"
          ],
          "Resource": "arn:${partition}:logs:${region}:${account}:log-group:/${name}/explorer:*"
        }
      ]
    }
