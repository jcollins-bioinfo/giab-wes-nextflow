{
  "$id": "https://raw.githubusercontent.com/jcollins-bioinfo/giab-wes-nextflow/main/schemas/m3-qc.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "qc"
    },
    "canonical": {
      "const": false
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "adapter_trimming": {
          "minLength": 1,
          "type": "string"
        },
        "additional_qc_artifacts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "minLength": 1,
                "type": "string"
              },
              "bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "filename": {
                "minLength": 1,
                "type": "string"
              },
              "record_count": {
                "minimum": 0,
                "type": "integer"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "filename",
              "role",
              "sha256",
              "bytes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "duplicate_metrics": {
          "additionalProperties": false,
          "properties": {
            "duplicate_pairs": {
              "minimum": 0,
              "type": "integer"
            },
            "duplicate_reads_from_metrics": {
              "minimum": 0,
              "type": "integer"
            },
            "libraries": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "raw_metrics": {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "filename": {
                  "minLength": 1,
                  "type": "string"
                },
                "record_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "role": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "filename",
                "role",
                "sha256",
                "bytes"
              ],
              "type": "object"
            }
          },
          "required": [
            "libraries",
            "duplicate_reads_from_metrics",
            "duplicate_pairs",
            "raw_metrics"
          ],
          "type": "object"
        },
        "lane_count": {
          "minimum": 1,
          "type": "integer"
        },
        "lane_validation_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "raw_read_count": {
          "minimum": 1,
          "type": "integer"
        },
        "read_count": {
          "minimum": 1,
          "type": "integer"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sample": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sample",
        "reference_sha256",
        "read_count",
        "raw_read_count",
        "lane_count",
        "adapter_trimming",
        "duplicate_metrics",
        "lane_validation_hashes",
        "additional_qc_artifacts"
      ],
      "type": "object"
    },
    "input_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "type": "string"
          },
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "filename": {
            "minLength": 1,
            "type": "string"
          },
          "record_count": {
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "filename",
          "role",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missingness": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "minLength": 1,
          "type": "string"
        },
        "package": {
          "const": "giab-wes-nextflow"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "module"
      ],
      "type": "object"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "runtime_architecture": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "units": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "validation_status": {
      "const": "validated_synthetic"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "producer",
    "synthetic",
    "canonical",
    "validation_status",
    "runtime_architecture",
    "input_artifacts",
    "units",
    "missingness",
    "data",
    "payload_sha256"
  ],
  "type": "object"
}
