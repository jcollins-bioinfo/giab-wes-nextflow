{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcollins-bioinfo/giab-wes-nextflow/schemas/m5-resources.schema.json",
  "title": "M5 raw Nextflow resource evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "package_version",
    "trace_sha256",
    "trace_units",
    "runtime",
    "runtime_provenance",
    "elapsed_wall_seconds",
    "timing_source",
    "started_at",
    "ended_at",
    "tasks",
    "groups",
    "end_to_end",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "m5-resources"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_units": {
      "const": "nextflow-raw-ms-bytes"
    },
    "runtime": {
