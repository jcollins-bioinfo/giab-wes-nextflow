          "status": {
            "enum": [
              "ABORTED",
              "CACHED",
              "COMPLETED",
              "FAILED"
            ]
          },
          "cached": {
            "type": "boolean"
          },
          "task_hash": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duration_seconds",
              "realtime_seconds",
              "cpu_percent",
              "requested_cpus",
              "requested_memory_bytes",
              "peak_rss_bytes",
              "peak_vmem_bytes",
              "cpu_hours_estimated",
              "cpu_hours_measured"
            ],
