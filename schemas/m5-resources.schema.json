            "minimum": 1
          },
          "attempt": {
            "$ref": "#/$defs/attempt"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "shared_preprocessing",
              "gatk_incremental",
              "deepvariant_incremental",
              "common_normalization_benchmark"
            ]
