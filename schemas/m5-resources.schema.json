          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "accelerator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "input_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "allOf": [
