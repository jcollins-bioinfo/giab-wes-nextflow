                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "evaluated_bases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
