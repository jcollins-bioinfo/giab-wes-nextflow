{
  "$id": "https://raw.githubusercontent.com/jcollins-bioinfo/giab-wes-nextflow/main/schemas/m2-source-mirror.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "publisher_version",
          "acquisition"
        ]
      }
    }
  ],
  "properties": {
    "acquisition": {
      "type": "object"
    },
    "created_utc": {
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "const": "verified-source-mirror-not-gate-b"
    },
    "objects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "destination": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "destination",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "publisher_version": {
      "minLength": 1,
      "type": "string"
    },
    "repository_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "runtime_architecture": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "source_manifest_sha256",
    "repository_sha",
    "runtime_architecture",
    "created_utc",
    "objects"
  ],
  "type": "object"
}
