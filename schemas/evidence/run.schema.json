{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-run/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextflow_version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "architecture": {
      "enum": [
        "linux/amd64",
        "linux/arm64",
        "darwin/arm64"
      ]
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "samplesheet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evaluation_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "common_bam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "container",
          "model"
        ],
        "properties": {
          "name": {
            "enum": [
              "gatk",
              "deepvariant"
            ]
          },
          "version": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "container": {
            "type": "string",
            "pattern": "@sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "comparability": {
      "enum": [
        "comparable",
        "not_comparable"
      ]
    },
    "comparison_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "commit",
    "tag",
    "nextflow_version",
    "profile",
    "architecture",
    "configuration_sha256",
    "samplesheet_sha256",
    "inputs",
    "reference",
    "truth",
    "target",
    "evaluation_domain",
    "common_bam",
    "callers",
    "comparability",
    "comparison_reason"
  ]
}
