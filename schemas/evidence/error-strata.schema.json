{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-error-strata/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "overlap_policy": {
      "enum": [
        "exclusive_priority",
        "multi_label"
      ]
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fp",
          "fn"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "fp": {
            "type": "integer",
            "minimum": 0
          },
          "fn": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "overlap_policy",
    "strata"
  ]
}
