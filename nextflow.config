manifest {
    name = 'jcollins-bioinfo/giab-wes-nextflow'
    author = 'John Patrick Collins'
    homePage = 'https://github.com/jcollins-bioinfo/giab-wes-nextflow'
    description = 'GIAB HG001 WES shared preprocessing; synthetic qualification, nonclinical'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.6'
    version = '0.5.0-dev.1'
}
plugins { id 'nf-schema@2.8.0' }
params {
    workflow_mode = 'foundation'
    m5_manifest = null
    known_sites = null
    m3_fixture_manifest = null
    m3_fixture_id = 'm3-preprocessing'
    m3_run_id = 'm3-synthetic'
    m3_repository_sha = null
    m3_qc_window = 500
    input = null
    outdir = 'results'
    callers = 'both'
    reference = null
    targets = null
    truth_vcf = null
    truth_bed = null
    retain_oq = true
    call_padding = 100
    benchmark = false
    max_cpus = 2
    provenance = true
    private_workspace_root = null
    help = false
}
includeConfig 'conf/base.config'
profiles {
    canonical { includeConfig 'conf/canonical.config' }
    canonical_colab { includeConfig 'conf/canonical_colab.config' }
    canonical_apptainer { includeConfig 'conf/canonical_apptainer.config' }
    canonical_docker { includeConfig 'conf/canonical_docker.config' }
    canonical_slurm { includeConfig 'conf/canonical_slurm.config' }
    canonical_awsbatch { includeConfig 'conf/canonical_awsbatch.config' }
    canonical_wave { includeConfig 'conf/canonical_wave.config' }
    test { includeConfig 'conf/test.config' }
    m3_test { includeConfig 'conf/m3_test.config' }
    m4_test { includeConfig 'conf/m4_test.config' }
    m5_test { includeConfig 'conf/m5_test.config' }
    test_full { includeConfig 'conf/test_full.config' }
    docker { docker.enabled = true }
}
workflow.output.enabled = true
outputDir = params.outdir
workflow.output.mode = 'copy'

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.tsv"
    raw = true
    fields = 'task_id,hash,name,status,attempt,exit,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,cpus,memory,container'
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_dag.dot"
}
